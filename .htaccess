# ==========================================================
# ServEasy Customer Web Portal Security Configuration
# ==========================================================
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Profile Aliases
    RewriteRule ^profile/?$ pages/user-profile.php [L,QSA]
    RewriteRule ^pages/profile/?$ pages/user-profile.php [L,QSA]

    # Safeguard: Automatically normalize accidental /pages/pages/ URLs to /pages/
    RewriteRule ^pages/pages/(.*)$ pages/$1 [R=301,L]
</IfModule>

# Protect sensitive files
<FilesMatch "(\.env|\.env\..*|\.log|\.sql|\.git|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Fallback index
DirectoryIndex index.php index.html
